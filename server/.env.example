PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-this-password
DB_NAME=gsuite_erp
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Rewards website (graphicstar.ph/rewards) reads customers + sales invoices through
# /api/integrations/loyalty with this key. Leave empty to keep the feed switched off.
LOYALTY_API_KEY=

# Signage Studio reads the Material Costing items through /api/integrations/material-costing
# (x-api-key header), and its Customers through /api/integrations/customers with the same key.
# Leave empty to keep both feeds switched off.
MATERIAL_COSTING_API_KEY=

# Sales > 3D Studio: sign-in link into the Signage Studio. Both empty = the menu item says it is not set up.
#   STUDIO_WEB_URL     what users' browsers open (office LAN: http://192.168.0.175:8080)
#   STUDIO_SSO_SECRET  32+ random chars, the same value as T1S_SSO_SECRET in the studio's .env
STUDIO_WEB_URL=
STUDIO_SSO_SECRET=
